#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        // My Layertap
        ml: behavior_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };
        lm: left_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions =
                <4 5 6 7
                12 13 14 15
                20 21 22 23>;
            hold-trigger-on-release;
            retro-tap;
        };
        rm: right_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions =
                <0 1 2 3
                8 9 10 11
                16 17 18 19>;
            hold-trigger-on-release;
            retro-tap;
        };
    };
    combos {
        compatible = "zmk,combos";
#define CONCAT2(x, y) x ## y
#define CONCAT(x, y) CONCAT2(x, y)
#define _(pos, k) CONCAT(combo, __COUNTER__) { key-positions = <pos>; bindings = <&kp k>; layers = <0 1 2 3>; timeout-ms = <75>; };

        /* unlock { key-positions = <0 1 2 3 4 5 6 7>; bindings = <&studio_unlock>; layers = <0>; timeout-ms = <100>; }; */
        _(0 1, Q)    _(1 2, V)       _(2 3, ESC)   _(4 5, RET)   _(5 6, EQUAL)  _(6 7, PLUS)
        _(8 9, EXCL) _(9 10, DOLLAR) _(10 11, SPACE) _(12 13, BSPC) _(13 14, SEMI) _(14 15, COLON)
        _(16 17, Z)  _(17 18, X)     _(18 19, TAB) _(20 21, DEL) _(21 22, FSLH) _(22 23, QMARK)

        _(0 8, BSLH)     _(1 9, GRAVE)  _(2 10, AMPS)  _(3 11, STAR)  _(4 12, UNDER)  _(5 13, DQT) _(6 14, SQT) _(7 15, CARET)
        _(8 16, PERCENT) _(9 17, TILDE) _(10 18, PIPE) _(11 19, HASH) _(12 20, MINUS) _(13 21, LT) _(14 22, GT) _(15 23, AT)

        _(1 3, LBKT) _(4 6, RBKT)
        _(9 11, LPAR) _(12 14, RPAR)
        _(17 19, LBRC) _(20 22, RBRC)
    };

#define BASE  0
#define LEFT_  1
#define RIGHT_ 2
#define ADJUST 3

    macros {
        #include "macros.dtsi"
    };

    adjust {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LEFT_ RIGHT_>;
            then-layer = <ADJUST>;
        };
    };

    keymap0: keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "Base";
            bindings = <
                // Z X V Q
&lm LALT H  &lm LGUI G &lm LSHFT E &lm LCTRL T &rm LCTRL U &rm LSHFT I &rm LGUI O &rm LALT P
&ml LEFT_ A &kp S      &kp D       &kp F       &kp N       &kp K       &kp L      &ml RIGHT_ B
&kp Y       &kp W      &kp C       &kp R       &kp M       &kp COMMA   &kp DOT    &kp J
            >;
        };
        left {
            bindings = <
            &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp N1 &kp N2 &kp N3 &none
            &none &trans       &trans       &trans       &kp N4 &kp N5 &kp N6 &kp N0
            &none &out OUT_USB &out OUT_BLE &bt BT_CLR   &kp N7 &kp N8 &kp N9 &none
            >;
        };

        right {
            bindings = <
            &trans &trans &trans &trans &kp HOME &kp UP   &kp END   &none
            &trans &trans &trans &trans &kp LEFT &kp DOWN &kp RIGHT &none
            &trans &trans &trans &trans &kp PGUP &none    &kp PGDN  &none
            >;
        };

        adjust {
            bindings = <
            &none &none  &school_email &none       &uiuc &i_email &live_email &phone
            &none &steve &none         &first_name &name &none    &last_name  &none
            &none &none  &none         &stvz       &none &none    &none       &none
            >;
        };
    };
};
